<div id="exitModal" class="exit-modal-overlay" style="display:none;">
  <div class="exit-modal-box">
    <h2>¿Salir de RAYKO PLAY?</h2>
    <p>¿Estás seguro de que deseas cerrar la aplicación?</p>
    <div class="exit-modal-buttons">
      <button id="btnCancelar" class="btn-cancelar">Cancelar</button>
      <button id="btnSalir" class="btn-salir">Salir</button>
    </div>
  </div>
</div>

<style>
.exit-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.exit-modal-box {
  background: #131A2B;
  border: 1px solid #2A3550;
  border-radius: 16px;
  padding: 24px;
  width: 85%;
  max-width: 360px;
  color: #fff;
  font-family: sans-serif;
}
.exit-modal-box h2 {
  margin: 0 0 8px;
  font-size: 20px;
}
.exit-modal-box p {
  margin: 0 0 20px;
  color: #A0AAC0;
  font-size: 14px;
}
.exit-modal-buttons {
  display: flex;
  gap: 12px;
}
.exit-modal-buttons button {
  flex: 1;
  padding: 12px;
  border: none;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
}
.btn-cancelar {
  background: #1E2740;
  color: #fff;
}
.btn-salir {
  background: #FF5252;
  color: #fff;
}
</style>

<script>
  function mostrarModalSalir() {
    document.getElementById('exitModal').style.display = 'flex';
  }

  function ocultarModalSalir() {
    document.getElementById('exitModal').style.display = 'none';
  }

  document.getElementById('btnCancelar').addEventListener('click', ocultarModalSalir);

  document.getElementById('btnSalir').addEventListener('click', function() {
    window.location.href = 'http://action_exit';
  });
</script>
